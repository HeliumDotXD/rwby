{
	"schemaVersion": 1,
	"id": "rwby",
	"version": "${version}",
	"name": "Trash RWBY Weapons Until I Learn Java",
	"description": "Learning project mod by helium.",
	"authors": [
		"helium"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/rwby/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.helium.RwbyMod"
		],
		"cardinal-components-entity": [
			"com.helium.aura.AuraEntityComponentInitializer"
		],
		"client": [
			"com.helium.RwbyModClient"
		]
	},
	"custom": {
		"cardinal-components": [
			"rwby:player_aura"
		]
	},
	"mixins": [
		"rwby.mixins.json",
		{
			"config": "rwby.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}
